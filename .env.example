# Public client configuration. These values are embedded into the app bundle,
# so never put service-role keys or other secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Existing projects can keep using EXPO_PUBLIC_SUPABASE_ANON_KEY instead.

# Required for production release. Keep the auth token in EAS secrets, not here.
EXPO_PUBLIC_SENTRY_DSN=https://your-public-dsn@sentry.io/project-id
SENTRY_ORG=your-sentry-organization
SENTRY_PROJECT=myprs
SENTRY_AUTH_TOKEN=set-this-in-eas-secrets

# Public landing page used in private friend challenge shares.
EXPO_PUBLIC_CHALLENGE_URL=https://myprs.app/challenge/

# Developer tools remain available automatically in local development. Keep this
# false in preview and production builds.
EXPO_PUBLIC_ENABLE_TEST_TOOLS=false
